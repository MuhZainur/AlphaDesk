# Copy to backend/.env and fill in. Never commit the real file.
GOOGLE_API_KEY=your-gemini-api-key
MODEL_NAME=gemini-3.8-flash
ALLOWED_ORIGINS=http://localhost:5173
DB_PATH=./alphadesk.db
RATE_LIMIT_PER_HOUR=6
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,recursive/flint-v1.0:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3.5-lightning:free
SEC_USER_AGENT=AlphaDesk portfolio demo your-email@example.com
